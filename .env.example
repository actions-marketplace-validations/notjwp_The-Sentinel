# The Sentinel — environment configuration example.
# Copy to `.env` and fill in. All optional integrations are inert without their
# credentials even when the flag is on. Settings are read via get_settings().

# ── LLM enrichment ────────────────────────────────────────────────────────────
ENABLE_LLM=true
LLM_MAX_CALLS=1
# Reasoning models generate their thinking before the answer; 45s is sized
# for that. Lower it only for a non-reasoning model.
LLM_TIMEOUT=45.0
# Enriched reviews per installation per day. 0 = unlimited (the default).
# Set it when the App is public: one key serves everyone, and past the cap
# reviews still post, with static recommendations. Needs REDIS_URL — the
# count has to survive restarts and be shared across replicas.
LLM_DAILY_QUOTA=0

# Provider is any OpenAI-compatible endpoint. Switch providers by editing the
# three vars below — no code change. LLM_API_KEY falls back to NVIDIA_API_KEY
# when unset (back-compat). Uncomment ONE preset.

# -- NVIDIA NIM (default; use a model that is actually served for your key) --
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY=
NVIDIA_API_KEY=your-nvidia-key-here

# -- Groq (free tier, fast; key from console.groq.com) --
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your_groq_key

# -- Google Gemini (free tier; key from aistudio.google.com) --
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-flash-latest
# LLM_API_KEY=your_gemini_key

# -- Ollama (local, free, offline; key is a dummy — Ollama ignores it) --
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
# LLM_API_KEY=ollama

# ── Documentation review / translation ────────────────────────────────────────
ENABLE_DOC_REVIEW=true
ENABLE_TRANSLATION=false

# ── Durability (Redis) ─────────────────────────────────────────────────────────
# Set to make the job queue and webhook dedup survive restarts (and be shared
# across replicas). Unset = in-memory: single-process, lost on restart.
# Local Redis:      redis://localhost:6379/0
# docker compose sets redis://redis:6379/0 for you (see docker-compose.yml).
REDIS_URL=

# ── GitHub App (PR comment posting) ───────────────────────────────────────────
ENABLE_GITHUB=true
# Native check runs (pass/fail in the merge box + inline annotations) alongside
# the review comment. Requires the app permission "Checks: Read & write" (and
# accepting the updated permissions on the installation); without it the check
# post fails safely and only the comment lands.
ENABLE_CHECKS=true
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Paste the PEM with literal \n between lines, or a real multi-line value.
GITHUB_PRIVATE_KEY=
GITHUB_API_BASE_URL=https://api.github.com
# Set in production to enforce X-Hub-Signature-256 webhook verification.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must match the secret configured on the GitHub App's webhook exactly.
GITHUB_WEBHOOK_SECRET=

# Deployment posture. "production" makes the webhook secret MANDATORY: the app
# refuses to start when ENABLE_GITHUB is on without GITHUB_WEBHOOK_SECRET, so a
# misconfigured deploy fails loudly instead of serving an unsigned endpoint.
# Anything else (default "development") keeps the warn-and-continue behavior.
ENVIRONMENT=development

# Bearer token guarding GET /metrics. Unset leaves the endpoint OPEN — set it
# before public exposure; the series leak review volume, severity mix, and queue
# depth. Scrape with: Authorization: Bearer <token>
METRICS_TOKEN=

# Port the container listens on. Injected automatically by some hosts
# (Render, Railway, Cloud Run); defaults to 8000 for compose, Fly, and docker run.
PORT=8000
